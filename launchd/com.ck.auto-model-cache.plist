<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ck.auto-model-cache</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__CODEX_ROOT__/auto-model-cache.py</string>
        <string>__CODEX_ROOT__</string>
    </array>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__CODEX_ROOT__/log/auto-model-cache.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__CODEX_ROOT__/log/auto-model-cache.stderr.log</string>
</dict>
</plist>